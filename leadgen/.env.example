# Lead sourcing — pick whichever you have:
# Hunter.io (https://hunter.io/api-keys) — free plan includes API access (~25 searches/month)
HUNTER_API_KEY=
# Apollo.io (console.apollo.io) — requires a PAID plan; free plan blocks API access entirely
APOLLO_API_KEY=

# Email sending (https://app.sendgrid.com)
SENDGRID_API_KEY=
FROM_EMAIL=you@yourcompany.com
FROM_NAME=Your Name

# CAN-SPAM requires a real postal address in every commercial email
COMPANY_POSTAL_ADDRESS="123 Main St, Springfield, USA"

# Max emails sent per run, and seconds to wait between sends (be a good citizen)
DAILY_SEND_LIMIT=50
SEND_DELAY_SECONDS=3

# Web dashboard — required if you deploy it publicly (leave DASHBOARD_PASSWORD
# blank only for local, single-user use)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
FLASK_SECRET_KEY=

# ICP (Ideal Customer Profile) fit scoring — free, rule-based. Comma-separated
# keywords matched against each lead's title/industry (case-insensitive).
# Leave blank to skip title/industry filtering (leads still get a baseline score).
ICP_TITLE_KEYWORDS=Head of Sales,VP Sales,Sales Director,CEO,Founder
ICP_INDUSTRY_KEYWORDS=Software,SaaS,Technology

# AI-personalized icebreakers (optional) — one Claude API call per lead to
# write a unique opening sentence instead of a fixed template line.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ICEBREAKER_MODEL=claude-sonnet-5-5
