# Lead sourcing (https://apolloio.docs.apiary.io/ or console.apollo.io)
APOLLO_API_KEY=

# Email sending (https://app.sendgrid.com)
SENDGRID_API_KEY=
FROM_EMAIL=you@yourcompany.com
FROM_NAME=Your Name

# CAN-SPAM requires a real postal address in every commercial email
COMPANY_POSTAL_ADDRESS="123 Main St, Springfield, USA"

# Max emails sent per run, and seconds to wait between sends (be a good citizen)
DAILY_SEND_LIMIT=50
SEND_DELAY_SECONDS=3

# Web dashboard — required if you deploy it publicly (leave DASHBOARD_PASSWORD
# blank only for local, single-user use)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
FLASK_SECRET_KEY=
